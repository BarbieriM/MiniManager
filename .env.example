# Copy to .env (git-ignored) and adjust. The Makefile exports these to every command.

# Local compose database (see compose.yaml). For Neon, use its connection string with sslmode=require.
DATABASE_URL=postgres://mini:mini@localhost:5433/mini_manager?sslmode=disable

# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-bytes

PORT=8080

# Used only by `make seed` (Card 1 rule 7). Password 8 to 72 characters, name 2 to 40.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
