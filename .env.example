# Copy to .env (git-ignored) and adjust. The Makefile exports these to every command.

# Local compose database (see compose.yaml). For Neon, use its connection string with sslmode=require.
DATABASE_URL=postgres://mini:mini@localhost:5433/mini_manager?sslmode=disable

# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-bytes

PORT=8080

# Invite and password reset emails (Cards 1 and 2). APP_BASE_URL is where the web app runs, for the links.
EMAIL_FROM=Mini Manager <onboarding@resend.dev>
APP_BASE_URL=http://localhost:5173
# Set exactly one: RESEND_API_KEY sends through Resend; EMAIL_OUTBOX_DIR writes each email to a file there instead
# (relative to api/, git-ignored), for local development. Open the newest file to follow its link.
RESEND_API_KEY=
EMAIL_OUTBOX_DIR=tmp/outbox

# Used only by `make seed` (Card 1 rule 7). Password 8 to 72 characters, name 2 to 40.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
